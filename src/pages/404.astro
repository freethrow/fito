---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница није пронађена">
  <meta name="robots" content="noindex" slot="head" />
  <section class="mx-auto max-w-[640px] px-5 py-24 text-center md:py-32">
    <div class="mb-4 text-[13px] font-bold tracking-[1.5px] text-gold uppercase">Грешка 404</div>
    <h1 class="mb-5 font-serif text-[34px] font-medium md:text-[42px]">Страница није пронађена</h1>
    <p class="mb-8 text-[16px] leading-[1.7] text-body1">Страница коју тражите не постоји или је премештена.</p>
    <a href="/" class="btn">Почетна страна</a>
  </section>
</BaseLayout>
