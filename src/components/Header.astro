---
import { getContent } from '../lib/content';
import { SECTION_KEYS, SECTION_META } from '../lib/sections';

const SITE_NAME = 'Друштво за фитотерапију Србије';
const { sections, articles } = await getContent();
const onHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const onArticles = Astro.url.pathname.startsWith('/clanci');

// Menu = every visible section that has a menu label. "Блог" opens the
// articles page when there are articles, otherwise it scrolls to the section.
const links = SECTION_KEYS.filter((k) => SECTION_META[k].nav && sections[k].visible).map((k) => ({
  href: k === 'blog' && articles.length ? '/clanci' : `${onHome ? '' : '/'}#${k}`,
  label: SECTION_META[k].nav!,
  active: k === 'blog' && onArticles,
}));
---

<header class="sticky top-0 z-20 border-b border-line bg-cream">
  <div class="flex items-center justify-between gap-4 px-5 py-4 md:px-12 md:py-[22px]">
    <a href={onHome ? '#' : '/'} class="flex items-center gap-3 md:gap-[14px]">
      <span class="text-base leading-tight font-semibold text-brand md:text-[18px]">{SITE_NAME}</span>
    </a>

    <nav aria-label="Главни мени" class="hidden flex-wrap items-center gap-[22px] text-sm font-bold tracking-wide xl:flex">
      {links.map((l) => <a href={l.href} class:list={['brand-link', l.active && 'underline decoration-golddot decoration-2 underline-offset-8']}>{l.label}</a>)}
    </nav>

    <button
      id="menu-btn"
      type="button"
      aria-label="Отвори мени"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-9 w-9 shrink-0 flex-col items-center justify-center gap-[5px] xl:hidden"
    >
      <span class="menu-bar block h-[2px] w-6 bg-ink transition-transform duration-200"></span>
      <span class="menu-bar block h-[2px] w-6 bg-ink transition-opacity duration-200"></span>
      <span class="menu-bar block h-[2px] w-6 bg-ink transition-transform duration-200"></span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Мобилни мени" class="hidden flex-col gap-1 px-5 pb-5 text-base font-bold tracking-wide xl:hidden">
    {
      links.map((l, i) => (
        <a href={l.href} class:list={['mobile-link brand-link block py-2', i < links.length - 1 && 'border-b border-line']}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const bars = btn.querySelectorAll<HTMLElement>('.menu-bar');

  function setOpen(open: boolean) {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Затвори мени' : 'Отвори мени');
    bars[0].style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
    bars[1].style.opacity = open ? '0' : '1';
    bars[2].style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
  }

  btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
