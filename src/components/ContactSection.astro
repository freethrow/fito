---
/** "Контакт и сарадња" — the dark band at the bottom of every page. */
import { getContent } from '../lib/content';
import Prose from './Prose.astro';
import { mdInline } from '../lib/utils';

const { sections } = await getContent();
const s = sections.kontakt;
---

{
  s.visible && (
    <footer id="kontakt" class="scroll-mt-20 bg-dark px-5 py-12 text-darktext md:px-14 md:py-[56px]">
      <div class="mx-auto max-w-[900px]">
        {s.title && <h2 class="mb-5 font-serif text-xl">{s.title}</h2>}
        {s.text && <Prose text={s.text} class="dark-prose mb-5 text-[15px] opacity-90" />}
        {
          s.items.length > 0 && (
            <div class="flex flex-col flex-wrap gap-4 text-[14.5px] opacity-85 md:flex-row md:gap-8">
              {s.items.map((i) => (
                <div>
                  <div class="dark-prose" set:html={mdInline(i.title)} />
                  {i.text && <div class="dark-prose mt-1 opacity-80" set:html={mdInline(i.text)} />}
                </div>
              ))}
            </div>
          )
        }
        {s.note && <Prose text={s.note} class="dark-prose mt-6 text-sm opacity-75" />}
      </div>
    </footer>
  )
}
