# Copy this file to .env and fill in the values (see DATOCMS.md, part 3).
# Without DATOCMS_API_TOKEN the site shows the original design text and no articles.

# DatoCMS → Project settings → API tokens → "Read-only API token"
# The website uses it at build time. Also add it to Netlify.
DATOCMS_API_TOKEN=

# A token with Content Management API access (role Admin) — create it yourself.
# Only for `npm run cms:setup`, run once on your computer.
# NEVER add this one to Netlify or GitHub.
DATOCMS_CMA_TOKEN=

# Optional: DatoCMS sandbox environment name (empty = primary).
DATOCMS_ENVIRONMENT=

# Optional: "true" on a separate preview deploy to show unpublished drafts.
DATOCMS_INCLUDE_DRAFTS=

# Public address of the site. Not needed on Netlify (it provides URL).
SITE_URL=
